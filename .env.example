# Скопируйте этот файл в .env и впишите свои ключи. Файл .env не попадает в git.

# Twitch: https://dev.twitch.tv/console/apps -> Register Your Application
# Без них программа работает, но без клипов зрителей и проверки ников.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Telegram: токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш Telegram ID. Если не знаете: оставьте пустым, напишите боту /start, он пришлёт ID.
TELEGRAM_OWNER_ID=

# YouTube Data API v3 (по желанию): нужен, чтобы читать чат YouTube-эфиров. Без него YouTube-каналы пишутся,
# но моменты ищутся только по звуку. Как получить — README, раздел «YouTube-эфиры».
YOUTUBE_API_KEY=

# routerai.ru: ключ API из личного кабинета
ROUTERAI_API_KEY=
